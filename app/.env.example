# 46630 = Robinhood Chain testnet (default), 4663 = Robinhood Chain mainnet, 31337 = local devnet (scripts/dev.sh)
VITE_CHAIN_ID=46630
VITE_ROBINHOOD_TESTNET_RPC=https://rpc.testnet.chain.robinhood.com/rpc
VITE_ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
VITE_LOCAL_RPC=http://127.0.0.1:8545
# Required in production for WalletConnect-based wallets (https://cloud.reown.com)
VITE_WALLETCONNECT_PROJECT_ID=
