{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  // Static Vite build served from Workers static assets; client-side routes fall back to index.html.
  "name": "xero",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  },
  // Served only on the custom domains: no duplicate workers.dev copy or per-version preview URLs
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "xeroprotocol.com", "custom_domain": true },
    { "pattern": "www.xeroprotocol.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
