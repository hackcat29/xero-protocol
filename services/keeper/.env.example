# Robinhood Chain mainnet
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Address book written by DeployProduction (deploy/out/4663.json) or DeployLocal
DEPLOYMENT=../../deploy/out/4663.json
# Reporter key (granted REPORTER_ROLE). Omit to run read-only.
REPORTER_PRIVATE_KEY=
# Keeper key for permissionless maintenance (sync, enforceInvariant). Defaults to the reporter key.
KEEPER_PRIVATE_KEY=
# true = log intended transactions without sending (default)
DRY_RUN=true
POLL_SECONDS=60
# Attest unsupported actions (mergers, spin-offs...), which halts stripping for that token.
AUTO_HALT=true
# Optional Slack/Discord-compatible webhook for alerts
ALERT_WEBHOOK_URL=
